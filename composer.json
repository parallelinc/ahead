{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/vue-starter-kit",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "brick/money": "^0.11.2",
        "dedoc/scramble": ">=0.13.22",
        "dedoc/scramble-pro": "^0.8.8",
        "grazulex/laravel-apiroute": ">=2.1",
        "inertiajs/inertia-laravel": "^3.1",
        "laravel/fortify": "^1.37",
        "laravel/framework": "^13.8",
        "laravel/horizon": "^5.46",
        "laravel/mcp": "^0.7.0",
        "laravel/nightwatch": "^1.26.1",
        "laravel/reverb": "^1.0",
        "laravel/telescope": "^5.20",
        "laravel/tinker": "^3.0.2",
        "laravel/wayfinder": "^0.1.20",
        "league/flysystem-aws-s3-v3": "^3.32",
        "nunomaduro/essentials": "^1.2",
        "saloonphp/saloon": "^4.0",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-csp": ">=3.25",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-onboard": "^2.6.3",
        "spatie/laravel-queueable-action": "^2.17",
        "spatie/laravel-webhook-server": ">=3.10",
        "symfony/http-client": "^8.0.9",
        "tightenco/ziggy": "dev-main"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "driftingly/rector-laravel": ">=2.3",
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.9.6",
        "laravel/boost": "^2.4.6",
        "laravel/pail": "^1.2.6",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.29.1",
        "laravel/sail": "^1.58",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.9.4",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-browser": ">=4.3.1",
        "pestphp/pest-plugin-laravel": "^4.1",
        "pestphp/pest-plugin-type-coverage": ">=4.0.4",
        "rector/rector": ">=2.4.3",
        "spatie/laravel-typescript-transformer": "^2.5.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta",
            "composer run idehelper",
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "dev:ssr": [
            "npm run build",
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"php artisan inertia:start-ssr\" --names=server,queue,logs,ssr --kill-others"
        ],
        "update:requirements": [
            "composer bump",
            "npx npm-check-updates -u"
        ],
        "lint": [
            "php artisan ide-helper:models -RW",
            "php artisan typescript:transform",
            "rector",
            "rector",
            "pint --parallel",
            "npm run lint"
        ],
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:unit": "pest --parallel --coverage --exactly=100.0",
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run",
            "npm run test:lint"
        ],
        "test:types": "phpstan",
        "test": [
            "@php artisan config:clear",
            "@test:type-coverage",
            "@test:unit",
            "@test:lint",
            "@test:types"
        ],
        "idehelper": "php artisan ide-helper:models -W && php artisan typescript:transform && ./vendor/bin/pint app",
        "phpstan": "composer run idehelper > /dev/null 2>&1 || true && ./vendor/bin/phpstan analyse --memory-limit=2G"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://satis.dedoc.co"
        }
    ],
    "minimum-stability": "stable"
}
